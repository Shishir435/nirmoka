#!/usr/bin/env bash
#
# Pre-push hook: run what CI runs, before waiting on CI.
#
# Enable once per clone (or `pnpm hooks:install`):
#     git config core.hooksPath .githooks
#
# Skip for a single push when you know what you're doing:
#     NIRMOKA_SKIP_HOOKS=1 git push
#
# Pre-push rather than pre-commit on purpose: clippy and the test suite are too
# slow to run on every commit, and a local commit that fails checks harms
# nobody. Pushing is the point where it starts costing other people time.

set -uo pipefail

if [[ "${NIRMOKA_SKIP_HOOKS:-}" == "1" ]]; then
  printf '\033[33mSkipping pre-push checks (NIRMOKA_SKIP_HOOKS=1).\033[0m\n'
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

failed=0
started=$SECONDS

# Run a check, print its outcome, remember failures. Output is never piped to
# head or tail — the pipeline would report the pager's exit code, so a red run
# would read green.
step() {
  local label="$1"
  shift

  printf '\n\033[1m▸ %s\033[0m\n' "$label"

  if "$@"; then
    printf '\033[32m✓ %s\033[0m\n' "$label"
  else
    printf '\033[31m✗ %s\033[0m\n' "$label"
    failed=1
  fi
}

# --- Rust -------------------------------------------------------------------
# If cargo is absent the Rust checks are skipped with a loud warning rather
# than blocking the push. CI remains the gate; this hook is a fast local
# preview of it, and a missing toolchain should not make the repo unpushable.
if command -v cargo > /dev/null 2>&1; then
  step "cargo fmt" cargo fmt --all -- --check
  step "cargo clippy" cargo clippy --workspace --all-targets -- -D warnings

  # Lib and bin targets only — see the same step in CI for why.
  step "no unwrap in shipping code" cargo clippy --workspace -- -D clippy::unwrap_used

  # Optional locally: it is a separate install, and CI is the gate. Skipping it
  # loudly beats making the repo unpushable for anyone who has not installed it.
  if command -v cargo-deny > /dev/null 2>&1; then
    step "cargo deny" cargo deny check
  else
    printf '\n\033[33m⚠ cargo-deny not found — licence and advisory checks skipped.\033[0m\n'
    printf '  Install: cargo install cargo-deny --locked\n'
  fi

  # Host clippy cannot see imports or branches removed by `#[cfg]` on another
  # target. Compile the deletion adapter's tests as Windows too: it is small,
  # platform-sensitive, and does not need linking or a Windows VM.
  windows_target=x86_64-pc-windows-gnu
  rust_host=$(rustc -vV | awk '/^host:/ { print $2 }')
  if [[ "$rust_host" != *windows* ]]; then
    # Ask the toolchain that will actually run, not rustup. `rustup target list`
    # answers for rustup's toolchain, but if another rustc comes first on PATH —
    # Homebrew's `rust` formula is the common way this happens — that is the one
    # cargo uses, and rustup's answer is about a toolchain nothing is invoking.
    # The symptom is a wall of "can't find crate for `std`" while compiling
    # third-party crates, which reads like a code problem and is not one.
    target_libdir=$(rustc --print target-libdir --target "$windows_target" 2> /dev/null || true)

    if [[ -n "$target_libdir" && -d "$target_libdir" ]]; then
      step "Windows-target adapter clippy" \
        cargo clippy \
          -p nirmoka-adapter \
          -p nirmoka-adapter-gdu \
          -p nirmoka-adapter-rip \
          --tests --target "$windows_target" -- -D warnings
    else
      # Skipped, not failed. CI runs this check on a clean rustup toolchain; a
      # local toolchain that cannot cross-compile should not make the repository
      # unpushable, which is the same rule the missing-cargo branch above follows.
      printf '\n\033[33m⚠ Windows-target adapter clippy skipped — no %s std for %s.\033[0m\n' \
        "$windows_target" "$(command -v rustc)"
      if command -v rustup > /dev/null 2>&1 &&
        rustup target list --installed 2> /dev/null | grep -qx "$windows_target"; then
        printf '  rustup has the target, but %s is ahead of rustup on PATH.\n' "$(command -v rustc)"
        printf '  Put ~/.cargo/bin first, or `brew uninstall rust` — a Homebrew rustc also\n'
        printf '  silently ignores the rust-toolchain.toml pin this repository sets.\n'
      else
        printf '  Install once: rustup target add %s\n' "$windows_target"
      fi
    fi
  fi

  step "cargo test" cargo test --workspace

  # `cargo test` has just rewritten the generated bindings. A diff here means a
  # Rust boundary type changed without its TypeScript mirror being committed,
  # which CI rejects — catching it now saves the round trip.
  step "generated types are current" \
    git diff --exit-code --quiet -- packages/transport/src/generated
else
  printf '\n\033[33m⚠ cargo not found — Rust checks skipped. CI will still run them.\033[0m\n'
  printf '  Install: curl --proto '"'"'=https'"'"' --tlsv1.2 -sSf https://sh.rustup.rs | sh\n'
fi

# --- Web --------------------------------------------------------------------
if command -v pnpm > /dev/null 2>&1; then
  step "oxlint" pnpm lint
  step "oxfmt" pnpm format:check
  step "typecheck" pnpm typecheck
else
  printf '\n\033[33m⚠ pnpm not found — web checks skipped.\033[0m\n'
fi

# --- Architecture -----------------------------------------------------------
# Same script CI runs, so the hook and CI cannot disagree.
step "architecture invariants" ./scripts/check-invariants.sh

# --- Result -----------------------------------------------------------------
elapsed=$((SECONDS - started))

if ((failed)); then
  printf '\n\033[31mPre-push checks failed after %ds. Push aborted.\033[0m\n' "$elapsed"
  printf 'Fix the above, or bypass with: NIRMOKA_SKIP_HOOKS=1 git push\n'
  exit 1
fi

printf '\n\033[32mAll pre-push checks passed in %ds.\033[0m\n' "$elapsed"
