{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nirmoka",
  "version": "0.2.0",
  "identifier": "app.nirmoka.desktop",
  "build": {
    "frontendDist": "../../apps/desktop/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "cwd": "../..",
      "script": "pnpm dev"
    },
    "beforeBuildCommand": {
      "cwd": "../..",
      "script": "pnpm build"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nirmoka",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 16 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Disk analysis and cleanup",
    "longDescription": "A cross-platform desktop GUI for disk analysis and cleanup, driving the disk scanner you already have installed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
