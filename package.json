{
  "name": "nirmoka",
  "version": "0.0.0",
  "private": true,
  "description": "A cross-platform desktop GUI for disk analysis and cleanup",
  "license": "Apache-2.0",
  "repository": "https://github.com/Shishir435/nirmoka",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @nirmoka/desktop dev",
    "build": "pnpm --filter @nirmoka/desktop build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint . --deny-warnings && pnpm test:web",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:web": "node --experimental-strip-types --test tools/*.test.mjs tools/*.test.mts",
    "hooks:install": "git config core.hooksPath .githooks && echo 'pre-push hook enabled'",
    "invariants": "./scripts/check-invariants.sh",
    "nrmk": "cargo run -p nirmoka-cli --",
    "tauri": "cd crates/app && tauri",
    "types": "cargo test -p nirmoka-app export_bindings",
    "rs:check": "cargo check --workspace --all-targets",
    "rs:test": "cargo test --workspace",
    "rs:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rs:lint:strict": "cargo clippy --workspace -- -D clippy::unwrap_used",
    "rs:deny": "cargo deny check",
    "rs:fmt": "cargo fmt --all"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0"
  }
}
