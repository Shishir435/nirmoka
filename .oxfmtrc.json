{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "sortPackageJson": false,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "dist/",
    "target/",
    "packages/transport/src/generated/",
    "fixtures/",
    "LICENSE"
  ]
}
